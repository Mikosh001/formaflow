{
  "name": "formaflow",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Trilingual Google Forms response workspace",
  "engines": {
    "node": ">=22.17.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:api": "node --experimental-strip-types server/index.ts",
    "build": "vite build",
    "build:api": "esbuild server/index.ts --bundle --platform=node --format=esm --outfile=build-server/index.mjs",
    "start": "node build-server/index.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/core.test.mjs tests/api.test.mjs",
    "pages:prepare": "node scripts/prepare-pages.mjs"
  },
  "dependencies": {
    "lucide-react": "^1.31.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "site-creator-vinext-starter": "file:../.."
  },
  "devDependencies": {
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "esbuild": "0.28.0",
    "typescript": "5.9.3",
    "vite": "8.0.13"
  }
}
